controllerMode: local
dependencies:
  local:
    kubeconfigPath: ""
    metricsProvider:
      type: prometheus
      url: "http://localhost:9090"
      bearerToken: ""
      insecureSkipTLSVerify: false
  inCluster:
    metricsProvider:
      type: prometheus
      url: ""
      bearerToken: ""
      insecureSkipTLSVerify: false
executionMode: both
controller:
  targetNamespace: "prometheus"
  targetClusterID: "dev"
  tasks:
    createStats:
      enabled: true
      schedule: "15m"
    applyRecommendation:
      enabled: false
      schedule: "5m"
      nodeStatsURL:
        host: "localhost:8080"
      overridesURL:
        host: "localhost:8080"
    nodeLoadMonitoring:
      enabled: false
      schedule: "60s"
    evictionForce:
      enabled: false
      schedule: "1m"
server:
  port: "8080"
  basicAuth:
    username: "admin"
    password: "admin"
webhook:
  port: "8443"
  certsDir: "/tmp/webhook-certs"
  statsURL:
    host: "localhost:8080"
db:
  type: postgres
  host: localhost
  port: 5432
  database: cruisekube
  username: cruisekube_user
  password: your_password_here
  sslmode: disable
