{
  // Use IntelliSense to learn about possible attributes.
  // Hover to view descriptions of existing attributes.
  // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
  "version": "0.2.0",
  "configurations": [

{
  "name": "Launch cruisekube",
  "type": "go",
  "request": "launch",
  "mode": "auto",
  "program": "${workspaceFolder}/cmd/cruisekube/main.go",
  "args": ["--config-file-path", "${workspaceFolder}/config-local.yaml"],
  "cwd": "${workspaceFolder}",
  "console": "integratedTerminal",
  "env": {
  }
},
    {
      "name": "Debug cruisekube",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/cruisekube/main.go",
      "args": ["--config-file-path", "${workspaceFolder}/config-local.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "env": {
          "CRUISEKUBE_RECOMMENDATIONSETTINGS_DISABLEMEMORYAPPLICATION": "false",
          "CRUISEKUBE_CONTROLLER_TASKS_APPLYRECOMMENDATION_METADATA_DRYRUN": "false",
          "CRUISEKUBE_WEBHOOK_RECOMMENDATIONSETTINGS_DISABLEMEMORYAPPLICATION": "false",
          "CRUISEKUBE_WEBHOOK_DRYRUN": "false",
      }
    },
    {
      "name": "Debug cruisekube [Webhook Mode]",
      "type": "go",
      "request": "launch",
      "mode": "debug",
      "program": "${workspaceFolder}/cmd/cruisekube/main.go",
      "args": ["--config-file-path", "${workspaceFolder}/config-local.yaml"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopOnEntry": false,
      "env": {
        "CRUISEKUBE_WEBHOOK_DRYRUN": "false",
        "CRUISEKUBE_RECOMMENDATIONSETTINGS_DISABLEMEMORYAPPLICATION": "false",
        "CRUISEKUBE_WEBHOOK_CERTSDIR": "dev",
        "CRUISEKUBE_EXECUTIONMODE": "webhook"
      }
    },
  ]
}